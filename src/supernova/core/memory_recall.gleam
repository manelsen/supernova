//// Memory Recall — Semantic Search via pgvector
////
//// Provides semantic search over memories using pgvector cosine similarity.
//// Integrates with the pgvector adapter for vector storage and retrieval.
////
//// ## Usage
////
//// ```gleam
//// import supernova/core/memory_recall
//// import supernova/adapters/pgvector
//// import gleam/option.{Some}
////
//// let assert Ok(conn) = pgvector.connect(config)
//// let assert Ok(id) = memory_recall.embed_and_store(conn, config, "important fact", embedding)
//// let assert Ok(results) = memory_recall.search(conn, config, query_embedding, Some(5))
//// ```

import gleam/dict
import gleam/list
import gleam/option.{type Option}
import gleam/result
import gleam/string
import supernova/adapters/pgvector
import supernova/core/memory/types as memory_types

// ============================================================================
// Types
// ============================================================================

/// A memory recalled via semantic search, with similarity score.
pub type RecalledMemory {
  RecalledMemory(
    /// The text content of the memory
    content: String,
    /// The embedding vector used for similarity search
    embedding: List(Float),
    /// Cosine similarity score (0.0 to 1.0, higher is more similar)
    score: Float,
  )
}

/// Errors that can occur during memory recall operations.
pub type MemoryRecallError {
  /// The pgvector adapter returned an error
  PgVectorError(pgvector.PgVectorError)
  /// No memories found matching the query
  NoMemoriesFound
}

// ============================================================================
// Public API
// ============================================================================

/// Search for memories similar to the query embedding.
///
/// Uses cosine similarity via pgvector to find the most relevant memories.
/// Returns up to `limit` results ordered by similarity (highest first).
/// Uses the adapter's default_limit if `limit` is `None`.
pub fn search(
  conn: pgvector.Connection,
  config: pgvector.PgVectorConfig,
  query_embedding: List(Float),
  limit: Option(Int),
) -> Result(List(RecalledMemory), MemoryRecallError) {
  pgvector.similarity_search(conn, config, query_embedding, limit)
  |> result.map_error(PgVectorError)
  |> result.map(fn(results) { list.map(results, from_search_result) })
}

/// Store content with its embedding for later semantic retrieval.
///
/// Takes pre-computed content and embedding, stores them in the pgvector table.
/// Returns the UUID of the inserted record on success.
pub fn embed_and_store(
  conn: pgvector.Connection,
  config: pgvector.PgVectorConfig,
  content: String,
  embedding: List(Float),
) -> Result(String, MemoryRecallError) {
  let record = to_embedding_record(content, embedding)
  pgvector.insert(conn, config, record)
  |> result.map_error(PgVectorError)
}

// ============================================================================
// Conversion Functions
// ============================================================================

/// Convert a pgvector SearchResult to a RecalledMemory.
///
/// Pure function — can be tested without a database connection.
pub fn from_search_result(result: pgvector.SearchResult) -> RecalledMemory {
  RecalledMemory(
    content: result.record.content,
    embedding: result.record.embedding,
    score: result.score,
  )
}

/// Convert a RecalledMemory to a pgvector EmbeddingRecord.
///
/// Pure function — can be tested without a database connection.
/// The record ID is empty (will be auto-generated by PostgreSQL on insert).
pub fn to_embedding_record(
  content: String,
  embedding: List(Float),
) -> pgvector.EmbeddingRecord {
  pgvector.EmbeddingRecord(
    id: "",
    content: content,
    embedding: embedding,
    metadata: dict.new(),
  )
}

/// Convert a RecalledMemory to a memory system MemoryEntry.
///
/// Pure function — bridges the semantic search results with the memory system.
/// Uses the content to generate a digest and the score as relevance.
pub fn to_memory_entry(
  recalled: RecalledMemory,
  created_at: Int,
  tags: List(String),
) -> memory_types.MemoryEntry {
  memory_types.MemoryEntry(
    digest: generate_digest(recalled.content),
    content: recalled.content,
    relevance: recalled.score,
    created_at: created_at,
    tags: tags,
  )
}

// ============================================================================
// Internal Helpers
// ============================================================================

/// Generate a digest for content deduplication.
/// Mirrors the logic from memory/pure.gleam for consistency.
fn generate_digest(content: String) -> String {
  let len = string.length(content)
  let first = string.slice(content, 0, 8)
  let last = string.slice(content, len - 8, 8)
  string.inspect(len) <> ":" <> first <> ":" <> last
}
