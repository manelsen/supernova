//// Zhipu Provider — GLM and CodeGeeX models from Zhipu AI.
////
//// Zhipu AI offers GLM-4 (general) and CodeGeeX-4 (coding-focused) models.
//// The API is OpenAI-compatible. Authentication supports two modes:
////
////   1. JWT (HS256) — when the key is in "id.secret" format.
////      The JWT is short-lived (30 s) and generated by the Erlang FFI.
////   2. Bearer token — plain key, used directly as-is.
////
//// The JWT header includes `"sign_type":"SIGN"` and all timestamps are
//// in MILLISECONDS (not seconds).
////
//// API base:     https://open.bigmodel.cn/api/paas/v4
//// Coding plan:  https://open.bigmodel.cn/api/coding/paas/v4
//// Docs:         https://open.bigmodel.cn/dev/api
////
//// ## Usage
////
//// ```yaml
//// # supernova.yaml
//// providers:
////   coding:
////     provider: zhipu_coding          # routes to /api/coding/paas/v4
////     model: codegeex-4
////     # api_key via SUPERNOVA_ZHIPU_API_KEY
////   default:
////     provider: zhipu
////     model: glm-4-plus
////     # api_key via SUPERNOVA_ZHIPU_API_KEY
//// ```

import gleam/hackney
import gleam/http
import gleam/http/request
import gleam/json
import gleam/option.{None, Some}
import gleam/string
import supernova/llm/provider
import supernova/llm/providers/openai

// ============================================================================
// Constants
// ============================================================================

const api_url = "https://open.bigmodel.cn/api/paas/v4/chat/completions"

const coding_url = "https://open.bigmodel.cn/api/coding/paas/v4/chat/completions"

/// Default model for `zhipu` — GLM-4 Plus (general, best quality).
/// Alternatives: "glm-4-air" (fast), "glm-4-flash" (free tier).
pub const default_model = "glm-4-plus"

/// Default model for `zhipu_coding` — CodeGeeX-4, Zhipu's code model.
pub const default_coding_model = "codegeex-4"

// ============================================================================
// Public API
// ============================================================================

/// Send a chat completion request via Zhipu AI (general endpoint).
pub fn chat(
  messages: List(provider.ChatMessage),
  config: provider.ProviderConfig,
  tools: List(provider.ToolDefinition),
) -> Result(provider.ChatResponse, provider.LLMError) {
  do_chat(messages, config, tools, api_url)
}

/// Send a chat completion request via Zhipu AI (coding plan endpoint).
///
/// Uses `https://open.bigmodel.cn/api/coding/paas/v4` which is optimised for
/// CodeGeeX-4 and code-related workloads.
pub fn chat_coding(
  messages: List(provider.ChatMessage),
  config: provider.ProviderConfig,
  tools: List(provider.ToolDefinition),
) -> Result(provider.ChatResponse, provider.LLMError) {
  do_chat(messages, config, tools, coding_url)
}

// ============================================================================
// Internal
// ============================================================================

fn do_chat(
  messages: List(provider.ChatMessage),
  config: provider.ProviderConfig,
  tools: List(provider.ToolDefinition),
  url: String,
) -> Result(provider.ChatResponse, provider.LLMError) {
  let body = build_request_body(messages, config.default_model, tools)

  case config.api_key {
    None ->
      Error(provider.ConfigError(
        reason: "No API key configured for " <> config.name,
      ))
    Some(api_key) -> {
      case build_jwt(api_key) {
        Ok(token) -> {
          case do_request(body, token, url) {
            Ok(response_body) -> openai.parse_response(response_body)
            Error(reason) -> Error(provider.NetworkError(reason: reason))
          }
        }
        Error(reason) ->
          Error(provider.ConfigError(reason: "Zhipu JWT error: " <> reason))
      }
    }
  }
}

fn do_request(
  body: String,
  token: String,
  url: String,
) -> Result(String, String) {
  let assert Ok(req) = request.to(url)

  let req =
    req
    |> request.set_method(http.Post)
    |> request.set_header("content-type", "application/json")
    |> request.set_header("authorization", "Bearer " <> token)
    |> request.set_body(body)

  case hackney.send(req) {
    Ok(response) -> {
      case response.status {
        200 -> Ok(response.body)
        status ->
          Error("API error " <> string.inspect(status) <> ": " <> response.body)
      }
    }
    Error(_) -> Error("Network error connecting to " <> url)
  }
}

// ============================================================================
// Request building
// ============================================================================

/// Build a Zhipu-specific request body.
///
/// For GLM-4.7 and newer models, appends `"thinking": {"type": "enabled"}` so
/// the model returns `reasoning_content` in its response.  Other models receive
/// the standard OpenAI-compatible payload unchanged.
fn build_request_body(
  messages: List(provider.ChatMessage),
  model: String,
  tools: List(provider.ToolDefinition),
) -> String {
  let base = openai.build_request_body(messages, model, tools)
  case needs_thinking(model) {
    False -> base
    True -> inject_thinking(base)
  }
}

/// Returns True for GLM-4.7+ and CodeGeeX-4.6+ where thinking is supported.
fn needs_thinking(model: String) -> Bool {
  string.starts_with(model, "glm-4.7")
  || string.starts_with(model, "glm-4-plus")
  || string.starts_with(model, "codegeex-4.6")
}

/// Inject `"thinking":{"type":"enabled"}` into an already-serialised JSON body.
///
/// Gleam's json library has no parse-and-modify API, so we take the pragmatic
/// route: strip the trailing `}`, append the extra field, and close again.
/// This is safe because `openai.build_request_body` always produces a JSON
/// object with a closing `}`.
fn inject_thinking(body: String) -> String {
  let thinking =
    json.object([
      #("type", json.string("enabled")),
    ])
    |> json.to_string
  let trimmed = string.drop_end(body, 1)
  trimmed <> ",\"thinking\":" <> thinking <> "}"
}

// ============================================================================
// FFI — JWT generation via Erlang crypto
// ============================================================================

@external(erlang, "supernova_zhipu_ffi", "build_jwt")
fn build_jwt(api_key: String) -> Result(String, String)
