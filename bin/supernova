#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

show_help() {
    cat <<EOF
Supernova CLI

Usage: supernova <command>

Commands:
    configure    Run the interactive setup wizard
    start        Start the Supernova server
    stop         Stop the running container
    logs         Tail container logs
    restart      Restart the container
    build        Build Docker image
    test         Run tests
    help         Show this help

Examples:
    supernova configure
    supernova start
    supernova logs
EOF
}

cmd_configure() {
    cd "$PROJECT_DIR"
    gleam run -m supernova/wizard_main
}

cmd_start() {
    cd "$PROJECT_DIR"
    make up-build
}

cmd_stop() {
    cd "$PROJECT_DIR"
    make down
}

cmd_logs() {
    cd "$PROJECT_DIR"
    make logs
}

cmd_restart() {
    cmd_stop
    cmd_start
}

cmd_build() {
    cd "$PROJECT_DIR"
    docker compose build
}

cmd_test() {
    cd "$PROJECT_DIR"
    gleam test
}

case "${1:-help}" in
    configure)  cmd_configure ;;
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    logs)       cmd_logs ;;
    restart)    cmd_restart ;;
    build)      cmd_build ;;
    test)       cmd_test ;;
    help|--help|-h) show_help ;;
    *)
        echo "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
