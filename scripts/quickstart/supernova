#!/usr/bin/env bash
#
# Supernova CLI - User-space service manager
# =========================================
# No root required. Uses Docker for wizard and runtime.
#
# Usage:
#   supernova install          Download and install
#   supernova configure        Run configuration wizard
#   supernova enable           Enable auto-start on login
#   supernova start            Start the service
#   supernova stop             Stop the service
#   supernova status           Show service status
#   supernova restart          Restart the service
#   supernova logs             Show logs
#   supernova update           Update to latest version
#   supernova doctor           Check system requirements
#   supernova help             Show this help

set -euo pipefail

# Configuration
SN_USER_DIR="${SN_USER_DIR:-$HOME/.local/supernova}"
SN_CONFIG_DIR="${SN_CONFIG_DIR:-$HOME/.config/supernova}"
SN_CONFIG="$SN_CONFIG_DIR/supernova.yaml"
SN_SECRETS="$SN_CONFIG_DIR/secrets.env"
SN_DATA="$SN_USER_DIR/data"
SN_LOGS="$SN_USER_DIR/logs"
SN_IMAGE="ghcr.io/manelsen/supernova:latest"
SN_CONTAINER_NAME="supernova"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${BLUE}[supernova]${NC} $*"; }
log_success() { echo -e "${GREEN}[supernova]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[supernova]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Check if Docker is available
has_docker() {
    command -v docker &>/dev/null && docker info &>/dev/null
}

# Create directories
create_dirs() {
    mkdir -p "$SN_USER_DIR"
    mkdir -p "$SN_USER_DIR/data"
    mkdir -p "$SN_USER_DIR/logs"
    mkdir -p "$SN_CONFIG_DIR"
}

# Pull image
pull_image() {
    log "Pulling Docker image..."
    docker pull "$SN_IMAGE"
}

# Install (pull Docker image)
cmd_install() {
    create_dirs

    if ! has_docker; then
        log_error "Docker is required. Install Docker and try again."
        exit 1
    fi

    log "Installing Supernova..."
    pull_image
    log_success "Installation complete."
    log ""
    log "Next: ./supernova configure"
}

# Configure - run wizard via Docker
cmd_configure() {
    create_dirs

    if ! has_docker; then
        log_error "Docker is required for configuration."
        exit 1
    fi

    log "Running configuration wizard..."

    # Stop container if running
    docker stop "$SN_CONTAINER_NAME" &>/dev/null || true

    # Run wizard in container
    docker run --rm -it \
        --name "${SN_CONTAINER_NAME}_wizard" \
        -v "$SN_CONFIG_DIR:/config" \
        -v "$SN_DATA:/data" \
        -w /app \
        "$SN_IMAGE" \
        run -m supernova/wizard_main

    if [[ -f "$SN_CONFIG" ]]; then
        log_success "Configuration saved to $SN_CONFIG"
    else
        log_error "Configuration failed"
        exit 1
    fi
}

# Start service
cmd_start() {
    if ! has_docker; then
        log_error "Docker is required to run Supernova."
        exit 1
    fi

    # Check if already running
    if docker ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log "Supernova is already running"
        return 0
    fi

    if [[ ! -f "$SN_CONFIG" ]]; then
        log_error "Configuration not found. Run: ./supernova configure"
        exit 1
    fi

    log "Starting Supernova..."

    # Load secrets into environment
    local -a env_args=()
    if [[ -f "$SN_SECRETS" ]]; then
        while IFS='=' read -r key value; do
            [[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
            env_args+=(-e "$key=$value")
        done < "$SN_SECRETS"
    fi

    docker run -d \
        --name "$SN_CONTAINER_NAME" \
        --restart unless-stopped \
        -v "$SN_CONFIG_DIR:/config" \
        -v "$SN_DATA:/data" \
        -v "$SN_LOGS:/app/logs" \
        "${env_args[@]}" \
        -w /app \
        "$SN_IMAGE" \
        run

    sleep 2

    if docker ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log_success "Supernova started"
        log "View logs: ./supernova logs"
    else
        log_error "Failed to start. Check: ./supernova logs"
        exit 1
    fi
}

# Stop service
cmd_stop() {
    if ! docker ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log "Supernova is not running"
        return 0
    fi

    log "Stopping Supernova..."
    docker stop "$SN_CONTAINER_NAME"
    log_success "Supernova stopped"
}

# Restart service
cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

# Status
cmd_status() {
    if docker ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log_success "Supernova is running"
        return 0
    else
        log "Supernova is not running"
        return 1
    fi
}

# Logs
cmd_logs() {
    if [[ "${1:-}" == "-f" ]] || [[ "${1:-}" == "--follow" ]]; then
        docker logs -f "$SN_CONTAINER_NAME"
    else
        docker logs --tail 50 "$SN_CONTAINER_NAME"
    fi
}

# Update
cmd_update() {
    if ! has_docker; then
        log_error "Docker is required."
        exit 1
    fi

    local was_running=false
    if docker ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        cmd_stop
        was_running=true
    fi

    log "Updating Docker image..."
    docker pull "$SN_IMAGE"
    log_success "Updated to latest"

    $was_running && cmd_start
}

# Enable auto-start (just a note about Docker Desktop)
cmd_enable() {
    log "For auto-start, configure Docker Desktop to start on login,"
    log "or use Docker Compose with a systemd user service."
    log ""
    log "Example docker-compose.yml:"
    cat << 'EOF'
services:
  supernova:
    image: ghcr.io/manelsen/supernova:latest
    container_name: supernova
    restart: unless-stopped
    volumes:
      - ~/.config/supernova:/config
      - ~/.local/supernova/data:/data
    environment:
      - SUPERNOVA_ANTHROPIC_API_KEY=${SUPERNOVA_ANTHROPIC_API_KEY}
EOF
}

# Doctor
cmd_doctor() {
    log "Checking system requirements..."
    local issues=0

    if has_docker; then
        log_success "Docker: installed"
    else
        log_error "Docker: not found"
        ((issues++))
    fi

    if [[ -d "$SN_CONFIG_DIR" ]]; then
        log_success "Config dir: $SN_CONFIG_DIR"
    else
        log "Config dir: not created"
    fi

    if [[ -f "$SN_CONFIG" ]]; then
        log_success "Config: $SN_CONFIG"
    else
        log "Config: not configured"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        log_success "All checks passed!"
    else
        log_error "$issues issue(s) found"
        exit 1
    fi
}

# Show help
show_help() {
    cat << EOF
Supernova - AI Operating System for Multi-Agent Systems

Usage: ./supernova <command>

Commands:
  install          Pull Docker image
  configure        Run configuration wizard (via Docker)
  enable           Show auto-start setup instructions
  start            Start the service (via Docker)
  stop             Stop the service
  restart          Restart the service
  status           Show service status
  logs             Show logs (-f to follow)
  update           Update to latest version
  doctor           Check system requirements
  help             Show this help

Requirements:
  - Docker installed and running
  - No root access required

Files:
  ~/.config/supernova/supernova.yaml   Configuration
  ~/.config/supernova/secrets.env      Secrets (optional)
  ~/.local/supernova/                 Data and logs

EOF
}

# Main
main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true

    case "$cmd" in
        install) cmd_install ;;
        configure|config) cmd_configure ;;
        enable) cmd_enable ;;
        start) cmd_start ;;
        stop) cmd_stop ;;
        restart) cmd_restart ;;
        status) cmd_status ;;
        logs) cmd_logs "$@" ;;
        update) cmd_update ;;
        doctor|check) cmd_doctor ;;
        help|--help|-h) show_help ;;
        *)
            log_error "Unknown command: $cmd"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
