#!/usr/bin/env bash
#
# Supernova CLI - Container-based service manager
# ===========================================
# Supports Docker and Podman. No root required.
#
# Usage:
#   supernova install          Pull container image
#   supernova configure        Run configuration wizard
#   supernova start           Start the service
#   supernova stop            Stop the service
#   supernova status          Show service status
#   supernova restart         Restart the service
#   supernova logs            Show logs
#   supernova update          Update to latest version
#   supernova doctor          Check system requirements
#   supernova help            Show this help

set -euo pipefail

# Configuration
SN_USER_DIR="${SN_USER_DIR:-$HOME/.local/supernova}"
SN_CONFIG_DIR="${SN_CONFIG_DIR:-$HOME/.config/supernova}"
SN_CONFIG="$SN_CONFIG_DIR/supernova.yaml"
SN_SECRETS="$SN_CONFIG_DIR/secrets.env"
SN_DATA="$SN_USER_DIR/data"
SN_LOGS="$SN_USER_DIR/logs"
SN_IMAGE="ghcr.io/manelsen/supernova:main"
SN_CONTAINER_NAME="supernova"

# Common paths for container runtimes (crun, runc)
export PATH="$PATH:/home/linuxbrew/.linuxbrew/bin:/usr/sbin"

detect_runtime() {
    if command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
        echo "docker"
    elif command -v podman &>/dev/null && podman info &>/dev/null 2>&1; then
        echo "podman"
    else
        echo ""
    fi
}

SN_RUNTIME="${SN_RUNTIME:-$(detect_runtime)}"

# Runtime flags (--runtime is podman-only)
if [[ "$SN_RUNTIME" == "podman" ]]; then
    SN_RUNTIME_FLAGS="--runtime /usr/sbin/runc"
else
    SN_RUNTIME_FLAGS=""
fi


# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${BLUE}[supernova]${NC} $*"; }
log_success() { echo -e "${GREEN}[supernova]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[supernova]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Check if container runtime is available
has_runtime() {
    [[ -n "$SN_RUNTIME" ]]
}

# Create directories
create_dirs() {
    mkdir -p "$SN_USER_DIR"
    mkdir -p "$SN_USER_DIR/data"
    mkdir -p "$SN_USER_DIR/logs"
    mkdir -p "$SN_CONFIG_DIR"
}

# Pull image
pull_image() {
    log "Pulling image..."
    $SN_RUNTIME pull "$SN_IMAGE"
}

# Install (pull image)
cmd_install() {
    create_dirs

    if ! has_runtime; then
        log_error "Container runtime (Docker or Podman) is required. Install one and try again."
        exit 1
    fi

    log "Installing Supernova using $SN_RUNTIME..."
    pull_image
    log_success "Installation complete."
    log ""
    log "Next: ./supernova configure"
}

# Configure - run wizard via container
cmd_configure() {
    create_dirs

    if ! has_runtime; then
        log_error "Container runtime is required for configuration."
        exit 1
    fi

    log "Running configuration wizard..."

    # Stop container if running
    $SN_RUNTIME stop "$SN_CONTAINER_NAME" &>/dev/null || true

    # Run wizard in container
    mkdir -p "$HOME/.config/supernova" "$HOME/.local/supernova/data"
    $SN_RUNTIME run --rm -i \
        --name "${SN_CONTAINER_NAME}_wizard" \
        -v "$HOME/.config/supernova:/config" \
        "$SN_IMAGE" \
        sh -c 'cd /app && gleam run -m supernova/wizard_main'

# Start service
cmd_start() {
    if ! has_runtime; then
        log_error "Container runtime is required to run Supernova."
        exit 1
    fi

    # Check if already running
    if $SN_RUNTIME ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log "Supernova is already running"
        return 0
    fi

    if [[ ! -f "$SN_CONFIG" ]]; then
        log_error "Configuration not found. Run: ./supernova configure"
        exit 1
    fi

    log "Starting Supernova..."

    # Load secrets into environment
    local -a env_args=()
    if [[ -f "$SN_SECRETS" ]]; then
        while IFS='=' read -r key value; do
            [[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
            env_args+=(-e "$key=$value")
        done < "$SN_SECRETS"
    fi

PN|    $SN_RUNTIME run -d \
KB|        $SN_RUNTIME_FLAGS \
TR|        --name "$SN_CONTAINER_NAME" \
        --restart unless-stopped \
        -v "$SN_CONFIG_DIR:/config" \
        -v "$SN_DATA:/data" \
        -v "$SN_LOGS:/app/logs" \
        "${env_args[@]}" \
        -w /app \
        "$SN_IMAGE" \
        gleam run

    sleep 2

    if $SN_RUNTIME ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log_success "Supernova started"
        log "View logs: ./supernova logs"
    else
        log_error "Failed to start. Check: ./supernova logs"
        exit 1
    fi
}

# Stop service
cmd_stop() {
    if ! $SN_RUNTIME ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log "Supernova is not running"
        return 0
    fi

    log "Stopping Supernova..."
    $SN_RUNTIME stop "$SN_CONTAINER_NAME"
    log_success "Supernova stopped"
}

# Restart service
cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

# Status
cmd_status() {
    if $SN_RUNTIME ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        log_success "Supernova is running"
        return 0
    else
        log "Supernova is not running"
        return 1
    fi
}

# Logs
cmd_logs() {
    if [[ "${1:-}" == "-f" ]] || [[ "${1:-}" == "--follow" ]]; then
        $SN_RUNTIME logs -f "$SN_CONTAINER_NAME"
    else
        $SN_RUNTIME logs --tail 50 "$SN_CONTAINER_NAME"
    fi
}

# Update
cmd_update() {
    if ! has_runtime; then
        log_error "Container runtime is required."
        exit 1
    fi

    local was_running=false
    if $SN_RUNTIME ps --format '{{.Names}}' | grep -q "^${SN_CONTAINER_NAME}$"; then
        cmd_stop
        was_running=true
    fi

    log "Updating container image..."
    $SN_RUNTIME pull "$SN_IMAGE"
    log_success "Updated to latest"

    $was_running && cmd_start
}

# Enable (info about auto-start)
cmd_enable() {
    log "For auto-start, configure your container runtime to start on login,"
    log "or use Docker Compose with a systemd user service."
}

# Doctor
cmd_doctor() {
    log "Checking system requirements..."
    local issues=0

    if has_runtime; then
        log_success "Container runtime: $SN_RUNTIME"
    else
        log_error "Container runtime: not found (Docker or Podman required)"
        ((issues++))
    fi

    if [[ -d "$SN_CONFIG_DIR" ]]; then
        log_success "Config dir: $SN_CONFIG_DIR"
    else
        log "Config dir: not created"
    fi

    if [[ -f "$SN_CONFIG" ]]; then
        log_success "Config: $SN_CONFIG"
    else
        log "Config: not configured"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        log_success "All checks passed!"
    else
        log_error "$issues issue(s) found"
        exit 1
    fi
}

# Show help
show_help() {
    cat << EOF
Supernova - AI Operating System for Multi-Agent Systems

Usage: ./supernova <command>

Commands:
  install          Pull container image
  configure        Run configuration wizard (via container)
  start            Start the service (via container)
  stop             Stop the service
  restart          Restart the service
  status           Show service status
  logs             Show logs (-f to follow)
  update           Update to latest version
  enable           Show auto-start setup info
  doctor           Check system requirements
  help             Show this help

Runtime: $SN_RUNTIME (set SN_RUNTIME=docker|podman to override)

Requirements:
  - Docker or Podman installed and running
  - No root access required

Files:
  ~/.config/supernova/supernova.yaml   Configuration
  ~/.config/supernova/secrets.env      Secrets (optional)
  ~/.local/supernova/                 Data and logs

EOF
}

# Main
main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true

    case "$cmd" in
        install) cmd_install ;;
        configure|config) cmd_configure ;;
        enable) cmd_enable ;;
        start) cmd_start ;;
        stop) cmd_stop ;;
        restart) cmd_restart ;;
        status) cmd_status ;;
        logs) cmd_logs "$@" ;;
        update) cmd_update ;;
        doctor|check) cmd_doctor ;;
        help|--help|-h) show_help ;;
        *)
            log_error "Unknown command: $cmd"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
