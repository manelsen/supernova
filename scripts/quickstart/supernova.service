[Unit]
Description=Supernova AI Operating System
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/supernova
ExecStart=%h/.local/supernova/bin/supernova run
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=supernova

# Environment
Environment=HOME=%h
Environment=USER=%u
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_DATA_HOME=%h/.local/share

# Graceful shutdown
TimeoutStopSec=30
SendSIGTERM=yes

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/supernova
ReadWritePaths=%h/.config/supernova

[Install]
WantedBy=default.target
