# Supernova Configuration Example
# Copy this file to supernova.yaml and fill in your values
#
#   cp supernova.yaml.example supernova.yaml
#   vim supernova.yaml
#
# Environment variable overrides work too — see .env.example

app_name: "supernova"
environment: development
log_level: info

# LLM Providers
# At least one required. Comment/uncomment as needed.
# API keys can use env var placeholders: "${VAR_NAME}"
# The agents use the provider whose name sorts first. Keep only the providers
# you use; with every block below, "anthropic" would win over "mistral".
#
# /model offers every provider here that has a key, each with its `model`
# and the optional `models` list. The choice is per agent and survives
# restarts. Give each extra model a price under `pricing.models`, or its cost
# counts at the default price against the ceilings.
providers:

  # https://mistral.ai — also serves DeepSeek; the agents run on it.
  mistral:
    api_key: "${SUPERNOVA_PROVIDER_MISTRAL_API_KEY}"
    model: "deepseek-v4-1-flash-1017"
    # models:
    #   - "mistral-large-latest"

  # https://platform.openai.com
  openai:
    api_key: "${SUPERNOVA_PROVIDER_OPENAI_API_KEY}"
    model: "gpt-5.4-2026-03-05"

  # https://anthropic.com/claude
  anthropic:
    api_key: "${SUPERNOVA_PROVIDER_ANTHROPIC_API_KEY}"
    model: "claude-sonnet-4-20260217"

  # https://openrouter.ai (aggregator, supports many models)
  openrouter:
    api_key: "${SUPERNOVA_PROVIDER_OPENROUTER_API_KEY}"
    model: "openrouter/free"

  # https://opencode.ai (OpenAI-compatible, self-hosted option)
  opencode_zen:
    api_key: "${SUPERNOVA_PROVIDER_OPENCODE_ZEN_API_KEY}"
    model: "claude-sonnet-4-6"

  # https://bigmodel.cn (智谱AI) — API: open.bigmodel.cn/api/paas/v4
  zhipu:
    api_key: "${SUPERNOVA_PROVIDER_ZHIPU_API_KEY}"
    model: "glm-5"

  # https://bigmodel.cn (智谱AI coding plan)
  zhipu_coding:
    api_key: "${SUPERNOVA_PROVIDER_ZHIPU_CODING_API_KEY}"
    model: "glm-5.1"

  # https://z.ai (智谱AI new platform, international) — API: api.z.ai/api/paas/v4
  zai:
    api_key: "${SUPERNOVA_PROVIDER_ZAI_API_KEY}"
    model: "glm-5"

  # https://z.ai (智谱AI coding plan on z.ai)
  zai_coding:
    api_key: "${SUPERNOVA_PROVIDER_ZAI_CODING_API_KEY}"
    model: "glm-5.1"

  # https://platform.minimax.io (Chinese LLM, international)
  minimax:
    api_key: "${SUPERNOVA_PROVIDER_MINIMAX_API_KEY}"
    model: "MiniMax-M2.7"

  # https://ollama.com (local/self-hosted models)
  ollama:
    api_key: "${SUPERNOVA_PROVIDER_OLLAMA_API_KEY}"
    model: "llama3"
    base_url: "http://localhost:11434"

# Channel Adapters
# Required env vars noted per channel below.

discord:
  # Required: SUPERNOVA_DISCORD_TOKEN
  token: "${SUPERNOVA_DISCORD_TOKEN}"
  enabled: false

telegram:
  # Required: SUPERNOVA_TELEGRAM_TOKEN
  token: "${SUPERNOVA_TELEGRAM_TOKEN}"
  enabled: false
  # Optional: a self-hosted Bot API server; the public API when absent.
  # https for any host name, http only on localhost or 127.0.0.1 (the token
  # travels in the URL). IPv6 literals are not supported.
  # base_url: "http://localhost:8081"

matrix:
  # Required: SUPERNOVA_MATRIX_HOMESERVER_URL, SUPERNOVA_MATRIX_TOKEN
  enabled: false

lark:
  # Required: SUPERNOVA_LARK_TOKEN, SUPERNOVA_LARK_BASE_URL
  enabled: false

google_chat:
  # Required: SUPERNOVA_GOOGLE_CHAT_WEBHOOK_URL
  enabled: false

slack:
  # Required: SUPERNOVA_SLACK_BOT_TOKEN
  enabled: false

mattermost:
  # Required: SUPERNOVA_MATTERMOST_BOT_TOKEN, SUPERNOVA_MATTERMOST_BASE_URL
  enabled: false

wechat_work:
  # Required: SUPERNOVA_WECHAT_WORK_CORP_ID, SUPERNOVA_WECHAT_WORK_AGENT_ID, SUPERNOVA_WECHAT_WORK_CORP_SECRET
  enabled: false

whatsapp:
  # Through GOWA (docs/operations/WHATSAPP.md). Required in .env:
  # SUPERNOVA_WHATSAPP_BASIC_AUTH and SUPERNOVA_WHATSAPP_WEBHOOK_SECRET.
  # The compose file sets bridge_url to http://gowa:3000.
  enabled: false
  # Every conversation in private: group messages are dropped unread.
  allow_groups: false

# Media people send (PRD-A). Audio, video and documents are read into text
# before the turn by a Gemini model (needs SUPERNOVA_GEMINI_API_KEY in .env):
# a literal transcription, an audio description with the speech
# transcribed, the document's content. The text stays in the conversation
# and the memory. Each reading is charged to the person. Images go to the
# agent's own model. Without the key, media become notes the agent answers.
# media:
#   reader_model: gemini-3.5-flash-lite
#   audio: read        # read | off
#   video: read
#   document: read

# Channels that receive by webhook (WhatsApp) and plain-http hosts.
channels:
  # GOWA talks plain http inside the compose network.
  internal_hosts: [gowa]
  webhook:
    # Inside the container; the port is not published (compose only).
    bind: 0.0.0.0
    port: 8790

# Budgets (per-agent limits, -1 = unlimited)
budgets:
  default:
    tokens_per_hour: 100000
    tool_calls_per_minute: 60
    max_recursion_depth: 5
    max_sub_agents: 3

# Tools
# tools:
#   browser:
#     # SECURITY WARNING: Enables arbitrary JavaScript execution in the browser
#     # page context via globalThis.eval(). Prompt injection against the LLM
#     # could run arbitrary JS in visited pages. Keep false unless required.
#     # Env override: SUPERNOVA_BROWSER_ALLOW_EVALUATE=true
#     allow_evaluate: false
#   # Seconds a tool may run before it is stopped and the model is told so.
#   # Built in: 60 for every tool, 300 for computador. Tool results longer
#   # than 20,000 characters are cut, with a notice, whatever the tool.
#   timeouts:
#     default: 60
#     computador: 300

# Closed group (PRD B1)
# New instances deny everyone until configured. Copy a real id from `/eu`.
access:
  mode: allowlist
  admins: []                 # e.g. ["telegram:123"]
  members: []                # e.g. ["discord:456"]
  denied_reply: "Esta instância é privada."
  allowed_chats: []          # e.g. ["telegram:-100123", "discord:guild:789"]
  # Env overrides (comma-separated): SUPERNOVA_ACCESS_ADMINS,
  # SUPERNOVA_ACCESS_MEMBERS, SUPERNOVA_ACCESS_ALLOWED_CHATS,
  # SUPERNOVA_ACCESS_MODE.

# Per-principal budgets (-1 = unlimited)
budget:
  member:
    tokens_per_hour: 200000
    tool_calls_per_hour: 60
  admin:
    tokens_per_hour: -1
    tool_calls_per_hour: -1

# Tools available to each role
capabilities:
  member:
    allowed: ["web", "web_fetch", "file_system", "canvas", "github", "agenda", "buscar_conversa"]
    denied: ["safe_shell", "process", "browser"]
  admin:
    allowed: ["*"]
    denied: []

# Anti-flood limits
rate_limit:
  member:
    messages_per_minute: 10
  admin:
    messages_per_minute: -1

# USD per million tokens used to estimate spend
pricing:
  default:
    input_per_mtok: 1.0
    output_per_mtok: 4.0
  models: {}
  # models:
  #   "openrouter/some-model":
  #     input_per_mtok: 0.5
  #     output_per_mtok: 1.5

# Instance-wide daily cap (-1 = no cap)
instance_budget:
  daily_usd: 5.0
  timezone: "America/Sao_Paulo"
  # Tokens reserved for the response when admitting an LLM call.
  reserve_output_tokens: 1000

# Conversation history, kept whole on disk under
# data_dir/agents/<person>/conversations/ so a restart does not cut the
# conversation; nothing is pruned, and /esquecer deletes it. Each user turn
# and each reply counts as one message.
conversation:
  # The most recent messages the model sees; it searches the older ones with
  # the buscar_conversa tool.
  history_limit: 100
  # Remembering what is older (docs/prd/PRD-M-memoria.md). A gate asks a
  # decision model whether each message asks about the past; when it does,
  # the turn starts with the lembrar tool already called. lembrar sends a
  # short list of excerpts of the person's conversation to the provider.
  # Off by default.
  #
  # provider: perplexity (default; Decider v1.3 and pplx-embed, key in
  # SUPERNOVA_PERPLEXITY_API_KEY; its embeddings keep no data, its Decisions
  # API does not train on it) or gemini (Gemini Decision 1, key in
  # SUPERNOVA_GEMINI_API_KEY; use the paid tier).
  # The cutoffs (gate_threshold, unlikely_below, likely_from) default to the
  # ones measured for the provider; probabilities are on different scales
  # from one model to another, so change them only with a new measurement.
  recall:
    enabled: false
    provider: perplexity
    gate_timeout_ms: 2000
    recall_timeout_ms: 15000

# Writable directory for access.json and the ledger
data_dir: "data"
