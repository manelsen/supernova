# Supernova Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider API Keys (at least one required)
# Format: SUPERNOVA_PROVIDER_{NAME}_API_KEY
SUPERNOVA_PROVIDER_OPENAI_API_KEY=sk-...
SUPERNOVA_PROVIDER_ANTHROPIC_API_KEY=sk-ant-...
# SUPERNOVA_PROVIDER_OPENROUTER_API_KEY=...
# SUPERNOVA_PROVIDER_OPENCODE_ZEN_API_KEY=...
# SUPERNOVA_PROVIDER_ZHIPU_API_KEY=...
# SUPERNOVA_PROVIDER_ZHIPU_CODING_API_KEY=...
# SUPERNOVA_PROVIDER_MINIMAX_API_KEY=...
# SUPERNOVA_PROVIDER_ZAI_API_KEY=...       # https://z.ai (智谱AI new platform)
# SUPERNOVA_PROVIDER_ZAI_CODING_API_KEY=...

# Channel Tokens (configure only the channels you use)
SUPERNOVA_TELEGRAM_TOKEN=123456:ABC-DEF...
SUPERNOVA_DISCORD_TOKEN=your-discord-bot-token
SUPERNOVA_DISCORD_APP_ID=1234567890

# Database (defaults match docker-compose postgres service)
# SUPERNOVA_DB_HOST=postgres
# SUPERNOVA_DB_PORT=5432
# SUPERNOVA_DB_NAME=supernova
# SUPERNOVA_DB_USER=supernova
# SUPERNOVA_DB_PASSWORD=supernova
