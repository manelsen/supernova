# Supernova environment
# Copy to .env next to docker-compose.yml, fill in, and protect it:
#   cp .env.example .env && chmod 600 .env
# Never commit .env.

# --- LLM provider (at least one) ----------------------------------------
# Format: SUPERNOVA_PROVIDER_{NAME}_API_KEY, where NAME is the provider's key
# in supernova.yaml, uppercased, with "-" turned into "_". The provider must
# also be declared in supernova.yaml. Agents use the provider whose name
# sorts first, so keep only the one you want.
# docker-compose.yml passes only Mistral, Anthropic and OpenAI to the
# container; for any other provider, add its variable there too.
SUPERNOVA_PROVIDER_MISTRAL_API_KEY=
# SUPERNOVA_PROVIDER_ANTHROPIC_API_KEY=
# SUPERNOVA_PROVIDER_OPENAI_API_KEY=
# SUPERNOVA_PROVIDER_OPENROUTER_API_KEY=
# SUPERNOVA_PROVIDER_OPENCODE_ZEN_API_KEY=
# SUPERNOVA_PROVIDER_ZHIPU_API_KEY=
# SUPERNOVA_PROVIDER_ZHIPU_CODING_API_KEY=
# SUPERNOVA_PROVIDER_ZAI_API_KEY=
# SUPERNOVA_PROVIDER_ZAI_CODING_API_KEY=
# SUPERNOVA_PROVIDER_MINIMAX_API_KEY=

# --- Channels (only the ones you use) -----------------------------------
# A token alone does not turn a channel on: also set `enabled: true` for it
# in supernova.yaml.
# Telegram bot token, from @BotFather.
SUPERNOVA_TELEGRAM_TOKEN=
# SUPERNOVA_DISCORD_TOKEN=
# SUPERNOVA_DISCORD_APP_ID=

# --- Access (closed group) ----------------------------------------------
# Format: channel:id, comma-separated. To find an id, send /eu to the bot.
# When set, these replace the lists in supernova.yaml; leave them commented
# out to keep the YAML lists.
# SUPERNOVA_ACCESS_ADMINS=telegram:000000000
# SUPERNOVA_ACCESS_MEMBERS=telegram:111111111,telegram:222222222

# The data directory (/data) is already set in docker-compose.yml;
# nothing is needed here for it.

# --- The agent's computer (optional) -------------------------------------
# A separate container with a shell and a browser; see
# docs/operations/COMPUTADOR.md. It needs gVisor (runsc) installed, unless
# you set SUPERNOVA_COMPUTER_RUNTIME=runc (much weaker isolation).
# COMPOSE_PROFILES=computador
# SUPERNOVA_COMPUTER_URL=http://computador:7070
# A random token, so only Supernova can drive the computer:
#   openssl rand -hex 24
# SUPERNOVA_COMPUTER_TOKEN=

# --- Observability (optional) --------------------------------------------
# Prometheus and Grafana, on the host's loopback only; see
# docs/operations/OBSERVABILITY.md. Profiles are comma-separated:
# COMPOSE_PROFILES=computador,observabilidade
# The Grafana "admin" password on first start (afterwards, change it in
# Grafana itself). Default: admin.
# SUPERNOVA_GRAFANA_PASSWORD=
